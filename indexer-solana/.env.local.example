# Tegridy Solana indexing leg — every environment variable that is actually read.
#
# Same convention as indexer/.env.local.example, and for the same reason: a
# list that documents a fraction of what the code reads is worse than no list,
# because it reads as complete. Everything below is grepped from src/config.js.
#
# Copy to .env.local for local dev. Production values are set in the host's
# dashboard, never committed. Deploy procedure: indexer-solana/DEPLOY.md.

# ─── RPC ─────────────────────────────────────────────────────────────────────
# Up to four Solana endpoints. The first is primary; the others are tried in
# order when one is UNREACHABLE (a refusal or a pruned range is not retried
# elsewhere — a second node answers those the same way).
#
# An AUTHENTICATED endpoint is required in practice. `getSignaturesForAddress`
# plus one `getTransaction` per signature is exactly the call pattern public
# endpoints rate-limit hardest, and a rate-limited tick makes no progress while
# reporting no error the operator will see.
#
# Note the retention question, which is not the same as the rate-limit one: a
# standard RPC node keeps only recent signature history. Indexing a pool older
# than that retention needs an archival provider, or the missing span is
# recorded as a `pruned-history` gap and stays one.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_RPC_URL_2=
# SOLANA_RPC_URL_3=
# SOLANA_RPC_URL_4=

# ─── Database ────────────────────────────────────────────────────────────────
# The SAME Postgres the Ponder app writes to. This service creates only
# solana_-prefixed tables, so it cannot collide with Ponder's reconciliation
# set (sql/001_solana_tables.sql explains why the prefix is load-bearing).
#
# DATABASE_PRIVATE_URL takes PRECEDENCE over DATABASE_URL when both are set —
# identical to the Ponder app, and for the same Railway reason.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DATABASE_PRIVATE_URL=

# ─── Watch set ───────────────────────────────────────────────────────────────
# JSON array. This is the whole configuration of WHAT gets indexed, and there is
# deliberately no discovery mode: a pool this service was never told about is
# not indexed, and that is visible in solana_watch rather than inferred.
#
#   pool           REQUIRED  the DBC pool account (32-byte base58)
#   baseMint       REQUIRED  the launched token's mint
#   quoteMint      REQUIRED  SOL / USDC / the exotic quote the config was made with
#   feeReceiver    optional  the Squads v4 VAULT that receives claimed partner
#                            fees. Without it, fee claims are NOT recognised at
#                            all and each pool carries a standing
#                            `fee-receiver-unset` row in solana_gap saying so.
#   label          optional  human name, for the status output
#   baseDecimals   optional  recorded only; amounts are stored in raw base units
#   quoteDecimals  optional
#   startSignature optional  the pool's creation signature. Supply it and the
#                            first run backfills to exactly there. Omit it and
#                            the first run reaches back only as far as one
#                            bounded walk gets, and writes a
#                            `history-not-backfilled` gap for the rest — which
#                            is honest, but it is not history.
#
# A malformed entry rejects the WHOLE set. Half a watch set indexes some pools
# and silently omits others, and an omitted pool is indistinguishable from a
# pool with no trades.
#
# SOLANA_WATCH=[{"pool":"…","baseMint":"…","quoteMint":"So11111111111111111111111111111111111111112","feeReceiver":"…","label":"first launch"}]

# ─── Status listener ─────────────────────────────────────────────────────────
# Unset means NO LISTENER AT ALL. Set it and /health, /ready and /status are
# served on that port — same three paths and same meanings as the Ponder app
# (indexer/DEPLOY.md §3). It serves no indexed data; rows are read from Postgres
# by whatever fronts them.
# SOLANA_STATUS_PORT=42070

# How long after the last SUCCESSFUL tick /ready starts answering 503.
# Default 120000 (2 minutes). Keep it a small multiple of the poll interval.
# SOLANA_STALE_AFTER_MS=120000

# ─── Tuning ──────────────────────────────────────────────────────────────────
# Seconds between passes over the watch set. Clamped to [2000, 600000].
# SOLANA_POLL_INTERVAL_MS=15000

# Signatures per getSignaturesForAddress page. Clamped to [1, 1000] (the
# cluster's own cap).
# SOLANA_SIGNATURE_PAGE_LIMIT=200

# How far back one tick will page toward the resume point before it stops and
# records the remainder as a `backlog-truncated` gap. The bound is not a
# performance knob: without it a long-behind cursor pages forever inside one
# tick, writing nothing, which looks exactly like a hang.
# SOLANA_MAX_PAGES_PER_TICK=20
