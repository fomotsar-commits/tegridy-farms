# Telegram notification bot — P2-8 of the 30-day UX push.
#
# Copy to `.env`, fill the real values, never commit.

# ── Telegram ─────────────────────────────────────────────────────────
# Create a bot via @BotFather, copy the token here.
TELEGRAM_BOT_TOKEN=

# ── Indexer ──────────────────────────────────────────────────────────
# Same URL the frontend uses (see frontend/.env.example INDEXER_URL).
# Bot polls this GraphQL endpoint every POLL_INTERVAL_MS.
INDEXER_URL=http://localhost:42069/graphql

# ── Behaviour ────────────────────────────────────────────────────────
# How often the bot polls the indexer, in milliseconds.
# Default 60_000 (60s). Lower = faster notifications, more RPC load.
POLL_INTERVAL_MS=60000

# Path to the on-disk state file (JSON). Bot persists user bindings,
# per-user thresholds, and "last seen" markers here so restarts don't
# replay history.
STATE_FILE=./.state.json

# ── Optional / observability ─────────────────────────────────────────
# Pin which chain id we verify wallet signatures against. Mainnet = 1.
CHAIN_ID=1
