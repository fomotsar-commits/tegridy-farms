# Tegridy indexer — every environment variable that is actually read.
#
# Two sources, and they are kept separate on purpose:
#   OURS      — read by ponder.config.ts / src/api/index.ts in this repo.
#   PONDER'S  — read by the framework itself (ponder 0.8.x). Listed because a
#               deploy that omits them fails in the framework, not in our code,
#               and the error text does not name the file to fix.
#
# Copy to .env.local for local dev. Production values are set in the host's
# dashboard, never committed. Deploy procedure: indexer/DEPLOY.md.

# ─── OURS: RPC (ponder.config.ts) ────────────────────────────────────────────
# Up to four mainnet endpoints, wrapped in viem's `fallback` transport so a
# single provider outage rotates instead of stalling the sync. At least one
# AUTHENTICATED endpoint is required in production — public nodes rate-limit
# eth_getLogs hard enough to stall historical sync indefinitely. With none set,
# the config warns and falls back to viem's public transport (local dev only).
PONDER_RPC_URL_1=https://eth.llamarpc.com
# PONDER_RPC_URL_2=
# PONDER_RPC_URL_3=
# PONDER_RPC_URL_4=

# ─── OURS: address overrides (ponder.config.ts) ──────────────────────────────
# Both default to the relaunch deployments baked into the config. Set these
# ONLY when pointing the indexer at a different deployment (a fork, a staging
# chain, or a post-redeploy address). An empty value is treated as unset; a
# wrong value silently indexes nothing, so verify against
# contracts/broadcast/*/1/run-latest.json before overriding.
# TEGRIDY_STAKING_ADMIN_ADDRESS=0x...
# SWAP_FEE_ROUTER_ADMIN_ADDRESS=0x...

# ─── OURS: CORS allowlist (src/api/index.ts) ─────────────────────────────────
# Comma-separated EXTRA browser origins allowed to call /graphql, appended to
# the three baked-in production origins. Preview/staging deploys go here.
# This is an allowlist, not auth — see the rate-limit requirement in DEPLOY.md.
# ALLOWED_ORIGINS=https://staging.example.com,http://localhost:5173

# ─── PONDER'S: database ──────────────────────────────────────────────────────
# Postgres connection string. Required in production; without it Ponder falls
# back to PGlite, which loses all indexed state on restart.
# DATABASE_PRIVATE_URL takes PRECEDENCE over DATABASE_URL when both are set —
# Railway injects both, the private one skipping egress billing, so leave it
# alone rather than overriding with the public URL.
# DATABASE_URL=postgresql://user:pass@host:5432/db
# DATABASE_PRIVATE_URL=

# Postgres schema Ponder owns. Every deploy of the same instance must reuse the
# same value or the new process re-indexes from scratch into a fresh schema.
# DATABASE_SCHEMA=public

# ─── PONDER'S: HTTP server ───────────────────────────────────────────────────
# Port for GraphQL + /health + /ready + /status + /metrics. Defaults to 42069.
# Bind this to the platform-provided port and keep it PRIVATE — the reverse
# proxy is the only thing that may face the internet (DEPLOY.md, M3 note).
# PORT=42069

# ─── PONDER'S: diagnostics ───────────────────────────────────────────────────
# PONDER_LOG_LEVEL=info          # error | warn | info | debug | trace
# PONDER_TELEMETRY_DISABLED=1    # opt out of framework telemetry
