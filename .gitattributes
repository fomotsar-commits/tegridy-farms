# Auto-detect text files and normalize to LF on check-in, restore native on check-out
* text=auto eol=lf

# Explicit text files
*.sol     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.sh      text eol=lf
*.toml    text eol=lf

# Lock files treated as binary — avoids line-ending churn
pnpm-lock.yaml     binary
package-lock.json  binary
yarn.lock          binary
foundry.lock       binary

# Generated ABIs — keep LF but don't diff on noise
frontend/src/lib/abi-supplement.ts text eol=lf linguist-generated

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary

# GitHub linguist overrides — don't count vendored assets as project code
# contracts/provenance: canonical Uniswap V2 sources are vendored + hash-pinned
# (upstream.lock.json) for the v2-provenance CI gate; expected/ diffs are
# generated by scripts/check-v2-provenance.mjs --update-snapshots.
contracts/provenance/upstream/**  linguist-vendored
contracts/provenance/expected/**  linguist-generated
frontend/public/art/**            linguist-vendored
frontend/public/nakamigos/**      linguist-vendored
frontend/public/collections/**    linguist-vendored
frontend/src/generated.ts         linguist-generated
# Anchor IDLs: emitted by `anchor build` in CI, committed because the operator's
# machine cannot run that build and the CI artifact expires. See solana/tegridy-amm/idl/README.md.
solana/tegridy-amm/idl/*.json     linguist-generated
contracts/out/**                  linguist-generated
contracts/cache/**                linguist-generated
contracts/broadcast/**            linguist-generated
# Gondi's verified source (contracts/vendor/gondi-v3.2/README.md). Its bytes are
# load-bearing: two of the contracts embed a metadata hash of their source, so no
# line-ending conversion, ever.
contracts/vendor/gondi-v3.2/sources/**                 -text linguist-vendored
contracts/vendor/gondi-v3.2/sources-address-manager/** -text linguist-vendored
contracts/vendor/gondi-v3.2/build/**                   linguist-generated
