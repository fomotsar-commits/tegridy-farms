{
  "name": "tegriddy-farms-root",
  "private": true,
  "description": "Root devDependencies for repo-wide tooling (OG banner rasterizer, etc.). The actual sub-projects live in frontend/, contracts/, indexer/ — each with their own package.json.",
  "license": "MIT",
  "scripts": {
    "render-og-png": "node scripts/render-og-png.mjs",
    "extract-abis": "node scripts/extract-missing-abis.mjs",
    "diff-addresses": "npx tsx scripts/diff-addresses.ts",
    "indexer:install": "npm --prefix indexer install",
    "indexer:dev": "npm --prefix indexer run dev",
    "indexer:serve": "npm --prefix indexer run serve",
    "indexer:codegen": "npm --prefix indexer run codegen",
    "telegram-bot:install": "npm --prefix services/telegram-bot install",
    "telegram-bot:dev": "npm --prefix services/telegram-bot run dev",
    "telegram-bot:start": "npm --prefix services/telegram-bot run start"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
