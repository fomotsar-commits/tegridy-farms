# Template for the ops env file. Copy it OUT of the repo first, for example to
#   C:\Users\jimbo\tegridy-ops-env\ops.env
# The scripts refuse an env file inside any git work tree; register-tasks.ps1 also
# refuses one inside OneDrive. Pass it with the script's own flag, after the script:
#   node scripts/ops/run-job.mjs <job> --env-file C:\Users\jimbo\tegridy-ops-env\ops.env
# Never use `node --env-file`: Node cuts every unquoted value at '#'.
#
# Format: NAME=value. Everything after the first '=' is the value, '#' included.
# Wrap a value in single quotes if it starts or ends with a space.

# Alarm: one healthchecks.io ping URL per job (docs/OPS_SCHEDULER.md, section 2).
HC_PING_URL_SYNTHETIC_MONITOR=https://hc-ping.com/<uuid>
HC_PING_URL_ARB_LINKAGE_MONITOR=https://hc-ping.com/<uuid>
HC_PING_URL_REVENUE_WATCH=https://hc-ping.com/<uuid>
HC_PING_URL_REGISTRY_ONCHAIN=https://hc-ping.com/<uuid>
HC_PING_URL_NPM_ADVISORIES=https://hc-ping.com/<uuid>
HC_PING_URL_SUPABASE_BACKUP=https://hc-ping.com/<uuid>

# Backup. The service key bypasses row-level security: this file is the only place it lives here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY='<service-role key>'
BACKUP_PASSPHRASE='<the passphrase from your offline copy>'
# Optional. Defaults: %USERPROFILE%\OneDrive\backups\supabase and 26 files.
# BACKUP_DIR=C:\Users\jimbo\OneDrive\backups\supabase
# BACKUP_KEEP=26

# Optional RPC overrides. Every job has keyless public defaults.
# ETH_RPC_URL=      arb-linkage (as RPC) and the stranded-credit read
# ETH_RPC=          revenue rails, registry, ladder builds
# SOL_RPC=          revenue rails (Solana)
# SOLANA_RPC=       registry (Solana)
# BASE_RPC=         registry and ladder builds (Base)
# SOLANA_FEE_ACCOUNT=   the one fee rail that is not watched until this is set
# TEGRIDY_LENDING=      set once TegridyLending is deployed
