# Template for backup.env, the file ONLY the Supabase backup reads. Copy it OUT of the repo, to
#   C:\Users\jimbo\tegridy-ops-env\backup.env
# It holds the service key, which bypasses row-level security, and the backup passphrase.
# The monitors never read it: register-tasks.ps1 passes it to the backup task alone, and
# refuses an ops.env that holds either secret. By hand:
#   node scripts/ops/supabase-backup.mjs --env-file C:\Users\jimbo\tegridy-ops-env\backup.env
#
# Format: NAME=value, as in ops.env.example. Quote each value with straight single quotes.

# Supabase: Settings > API Keys. The legacy service_role key (starts with eyJ) or a secret
# key (starts with sb_secret_), or SUPABASE_SERVICE_KEY from Vercel's production env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY='<service key>'
BACKUP_PASSPHRASE='<the passphrase from your offline copy>'
# Optional. Defaults: %USERPROFILE%\OneDrive\backups\supabase and 26 files.
# BACKUP_DIR=C:\Users\jimbo\OneDrive\backups\supabase
# BACKUP_KEEP=26
