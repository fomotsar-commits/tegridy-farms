legacy-peer-deps=true

# Dependency lifecycle scripts are OFF by default.
#
# `npm ci` otherwise executes `preinstall`/`install`/`postinstall` from every
# transitive dependency, as the installing user, before a single line of this
# app runs. Seven packages in the current tree do exactly that
# (@reown/appkit, bigint-buffer, bufferutil, keccak, protobufjs, secp256k1,
# utf-8-validate), and the runners that install here also hold deploy and
# service credentials — one compromised release of any of them is arbitrary
# code execution next to those secrets.
#
# .github/workflows/ci.yml already passes `--ignore-scripts` on the command
# line, but that only protects the invocations someone remembered to flag.
# Setting it here makes it the DEFAULT for every install of this package —
# CI, Vercel builds, and local machines alike — so a new workflow or a
# developer typing `npm ci` is safe without having to know.
#
# Safe for this project: none of the seven are build-critical (the native
# addons all fall back to prebuilds or pure JS), and esbuild/rollup use
# optional platform packages rather than install hooks. Explicit
# `npm run <script>` is unaffected — only automatic pre/post hooks are
# skipped, and frontend/package.json declares none.
ignore-scripts=true
