# Audit Finding #93: .env.example listing all required environment variables
# Copy this file to .env and fill in real values
#
# ───────────────────────────────────────────────────────────────────────
# IMPORTANT — SECRET HANDLING
#   • Client-side vars are prefixed VITE_* and ARE bundled into the JS ship.
#     Never put secrets you don't want public behind a VITE_ prefix.
#   • Server-only secrets (marked below) MUST live in Vercel Project Settings
#     → Environment Variables, and NEVER in a committed file.
#   • This template lists server-only keys as placeholders so contributors
#     know they exist; do not fill them in here.
# ───────────────────────────────────────────────────────────────────────
#
# ───────────────────────────────────────────────────────────────────────
# WHY THIS FILE IS LONGER THAN IT WAS
#
# It documented 18 keys while the code read well over thirty. The gap was not
# harmless padding: every missing one was OPTIONAL AND FAIL-QUIET, so an
# operator who provisioned exactly what this template listed got a deployment
# that came up green with whole features silently inert — the Solana DBC rail
# unable to launch, the certification lane answering "not certified" to
# everyone, the push sender disabled, the Ethplorer path on a shared free key.
# Nothing logged, nothing 500'd, nothing looked wrong.
#
# So every entry below now states WHAT HAPPENS WHEN IT IS UNSET. A default is
# not self-evidently safe just because it is a default — some of these fail
# CLOSED (good: the feature is off), some fail OPEN (a shared key, a weaker
# cookie), and the two must not look alike in a config file.
#
# If you add an env read to the code, add it here in the same change.
# ───────────────────────────────────────────────────────────────────────

# ── Client-side (safe to bundle) ─────────────────────────────────────────

# WalletConnect project ID — get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# 0x Swap API key — get one at https://0x.org/
# ⚠️ READ BY NOTHING. No source file references VITE_0X_API_KEY (verified by grep
# over src/ and api/, 2026-08-12). Setting it has no effect; it is left listed
# only so nobody re-adds it believing it was missed. Drift in the OTHER direction
# from the one this file usually has — documented, but not wired.
VITE_0X_API_KEY=your_0x_api_key_here

# Etherscan key moved to server-only section (R001 — was VITE_ prefixed).
# All Etherscan reads now go through /api/etherscan proxy.

# AUDIT FIX 2026-05-26 [H-35]: VITE_-prefixed Alchemy key was a leak vector —
# anything prefixed `VITE_` is inlined into the public client bundle. Use the
# server-only `ALCHEMY_API_KEY` and route reads through `/api/alchemy` instead.
# (Vite plugin filtered VITE_ALCHEMY_API_KEY out of the build BEFORE this fix
#  as defense-in-depth, but documenting it as "client-safe" in this file was
#  itself the bug — a future contributor would have copied the pattern.)

# Supabase — ANON key is designed to be public with RLS enforcement
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Push notifications (optional) — generate VAPID keys
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Error & analytics endpoints (optional, public)
VITE_ERROR_ENDPOINT=
# First-party analytics sink (api/analytics.js). Blank = events are batched by
# lib/analytics.ts and then DISCARDED, which is how this project ran for months
# with no traffic number at all. Set to /api/analytics to turn it on; the sink
# additionally needs SUPABASE_URL + SUPABASE_SERVICE_KEY and migration 013.
VITE_ANALYTICS_ENDPOINT=/api/analytics

# ── Solana fee-capture surface (Surface A) ───────────────────────────────
# Base58 pubkey of the Tegridy fee-collector wallet (ideally a Squads vault).
# The /solana swap surface stays gated (FeatureNotDeployed + hidden from nav)
# until this is set, then auto-un-gates. The platform fee is collected on the
# SOL/USDC leg of a pair, so pre-create that wallet's wSOL + USDC ATAs.
VITE_SOLANA_FEE_ACCOUNT=
# Platform fee in basis points (100 = 1.0%, default 100). Keep <= 100.
VITE_SOLANA_PLATFORM_FEE_BPS=100
# (The Solana RPC is SERVER-only now — see SOLANA_RPC_URL below. The browser
#  talks only to our same-origin /api/solrpc proxy, so no VITE_ RPC var exists.)

# ── Client-side feature dials (VITE_*, bundled; all OPTIONAL) ────────────
# None of these is a secret and none is required to boot. Each one silently
# changes what the shipped app can do, which is exactly why they belong here.

# Canonical public origin used as `record_url` when a launch is announced to
# Jungle Bay Island (lib/launcher/notifyBirth.ts:45-49).
# UNSET → 'https://memetic.fun'.
# `window.location.origin` is DELIBERATELY not used: a launch made from a
# preview deployment or localhost would publish a URL nobody else can resolve,
# and the island stores it permanently. Set this on any origin that is not
# memetic.fun; leave it alone on production.
VITE_CANONICAL_ORIGIN=

# Does the Heat gate DENY, or only inform? (lib/heat/heatGateConfig.ts:41)
# UNSET → ENABLED. Only the literal value `off` disables denial, and denial is
# the default — this one does NOT fail quiet, and turning the gate off is a
# deliberate act. With `off`, the card and the door still render the reading;
# they just stop refusing.
VITE_HEAT_GATE=

# Launch floor, in island_heat degrees. UNSET → LAUNCH_FLOOR from
# lib/heat/heatOracle.ts (currently 80 = Resident; it was 180 and was lowered).
# A non-numeric, negative or ZERO value is IGNORED, not obeyed: `0` would admit
# every wallet including a brand-new one, so a typo must not be able to open
# the door. Overriding here changes policy without touching the standard.
VITE_HEAT_LAUNCH_FLOOR=

# Freshness window for a Heat reading, in days. UNSET → GATE_MAX_AGE_DAYS
# (7). Same "ignore a nonsense value" rule; NOT clamped downward, so a stricter
# (smaller) window is allowed.
VITE_HEAT_MAX_AGE_DAYS=

# Where the island publishes certification state for the GARDEN lane.
# UNSET → `isCertified()` answers FALSE for everyone and the lane is dark.
# That is the correct state today (the island's first certifications have not
# closed) and it is fail-closed on purpose: the venue must NEVER self-declare
# certification. Set it only when the island publishes the endpoint.
VITE_ISLAND_CERTIFICATION_URL=

# The live Meteora DBC partner config the /solana-launch rail launches against
# (lib/launcher/solana/dbc.ts:106).
# UNSET → `isSolanaSubmitReady()` is FALSE. The nav shows "Soon" and submit is
# disabled — the rail cannot launch anything, however the feature flag is set.
# Left unset by default because publishing the config address also publishes
# the Squads vault it names as feeClaimer, which is the operator's call.
VITE_SOLANA_DBC_CONFIG=

# ── Server-only (set in Vercel dashboard; leave blank here) ──────────────
# DO NOT paste real values into this file. These are only referenced so new
# contributors know what /api routes expect. Values live in Vercel env only.

# Alchemy high-quota key used by the /api proxies
ALCHEMY_API_KEY=

# Etherscan API key — used by /api/etherscan proxy. NEVER use VITE_ prefix
# (that bundles secrets into client JS). Per R001, this was previously leaked
# via VITE_ prefix; rotate the key on etherscan.io and place new value in Vercel.
ETHERSCAN_API_KEY=

# OpenSea API key — used by /api/opensea
OPENSEA_API_KEY=

# Supabase service-role key — used by /api/auth/siwe for nonce storage
# NEVER exposed to the browser. Bypasses RLS. Treat as root credential.
SUPABASE_SERVICE_KEY=

# Supabase JWT secret — used to sign siwe_jwt cookies
# Identical to the secret visible in Supabase → Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Upstash Redis for per-IP rate limiting on Vercel functions
# In production the limiter fails closed (503) when these are unset — required.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical CORS origin used as the fallback when the request origin is
# not on the allow-list in each /api handler.
ALLOWED_ORIGIN=https://tegridyfarms.vercel.app

# Solana RPC endpoint for the /api/solrpc proxy (server-only — NEVER VITE_).
# A KEYED URL is SAFE here because it stays server-side and is never shipped to
# the browser: Helius/QuickNode/Triton with the key in the URL is fine. Unset →
# public (rate-limited) https://api.mainnet-beta.solana.com.
SOLANA_RPC_URL=

# Second Alchemy key, used for automatic failover by _lib/alchemy-failover.js,
# _lib/eth-code.js and _lib/ethcall.js. UNSET → NO FAILOVER: a rate-limited or
# down primary is simply a failed read. Cheap insurance; nothing warns you that
# you do not have it.
ALCHEMY_API_KEY_FALLBACK=

# Ethplorer key for the /api/v1 token-holder path (api/v1/index.js:156).
# UNSET → the literal string "freekey", Ethplorer's SHARED public demo key.
# That is a fail-OPEN default: it works in testing and is throttled to nothing
# under real traffic, so this reads as an intermittent bug rather than a
# missing credential. The trust-tooling surfaces depend on it.
ETHPLORER_API_KEY=

# Supabase URL / anon key as seen by the SERVERLESS functions. Every /api
# handler reads `SUPABASE_URL || VITE_SUPABASE_URL` and likewise for the anon
# key, so on Vercel the VITE_-prefixed pair alone is sufficient. These exist so
# a non-Vite host (or a local `vercel dev` without the client env) can supply
# them independently. UNSET and with no VITE_ fallback → the auth, analytics
# and proxy routes fail.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Web-push signing pair + contact subject for _lib/push.js.
# VAPID_PUBLIC_KEY must match VITE_VAPID_PUBLIC_KEY above — the browser
# subscribes with one and the server signs with the other; a mismatch produces
# subscriptions the sender cannot deliver to.
# EITHER KEY UNSET → the push sender is DISABLED and returns quietly. Users can
# still subscribe; nothing is ever delivered.
# VAPID_SUBJECT unset → "mailto:ops@tegridyfarms.vercel.app", which is a stale
# domain. Set it to a monitored address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# HMAC secret for the memetics birth-announcement endpoint (_lib/births.js:222).
# UNSET → the endpoint rejects. Fail-closed, which is right: it authenticates
# announcements attributed to this venue.
MEMETICS_BIRTH_SECRET=

# Comma-separated extra CORS origins, read by /api/analytics, /api/auth/me and
# /api/auth/siwe IN ADDITION to their built-in allow-lists and ALLOWED_ORIGIN.
# UNSET → only the built-in origins are accepted. Adding an origin here is a
# real widening of the auth surface; do not use it for convenience.
ALLOWED_ORIGINS=

# Chain id Seaport order signatures are verified against (_lib/seaport-verify.js:52).
# UNSET → 1 (Ethereum mainnet). Only change it for a testnet deployment; a wrong
# value makes every genuine signature verify as invalid.
SEAPORT_CHAIN_ID=

# NFT bundle listing. UNSET (or anything but the literal "true") → the bundle
# routes on /api/orderbook refuse. Fail-closed by design; go-live is migration
# 012, then this, then the frontend flag, then QA.
BUNDLE_LISTING_ENABLED=

# ⚠️ DEVELOPMENT ONLY. "true" drops the `Secure` attribute from the siwe_jwt
# cookie so it survives plain http on localhost. In production this is a
# session-token-over-cleartext downgrade. Never set it on a deployed
# environment; authCookie.js:32 additionally refuses to honour it when
# NODE_ENV=production.
DISABLE_SECURE_COOKIE=

# ── Rate-limit ceilings (all optional; per-minute, aggregate across all IPs) ──
# These are the GLOBAL breakers, not the per-IP limiter. When one trips the
# route sheds load with 503 and logs "[ratelimit] GLOBAL BREAKER tripped".
# UNSET → the default beside each name, which is the tuned value; raise one
# from the dashboard with no redeploy if a 503 turns out to be organic traffic.
# Defaults are on their own comment lines, not trailing the `KEY=`: dotenv strips
# an inline `#` but the Vercel dashboard importer does not, so a trailing comment
# can end up as the literal VALUE.
#
#   ALCHEMY_GLOBAL_RPM            default 2400  /api/alchemy
#   ETHERSCAN_GLOBAL_RPM          default 300   /api/etherscan
#   AGGREGATOR_GLOBAL_RPM         default 600   _lib/aggregator-proxy, per provider
#                                               unless the provider sets globalLimit
#   HEAT_GLOBAL_RPM               default 300   the Heat oracle proxy
#   RECORD_GLOBAL_RPM             default 600   launch-record reads
#   BIRTHS_GLOBAL_RPM             default 40    birth announcements — a WRITE path,
#                                               deliberately two orders lower
#   LAUNCH_RADAR_GLOBAL_RPM       default 120
#   LAUNCH_COHORT_GLOBAL_RPM      default 90
#   LAUNCHER_OUTCOMES_GLOBAL_RPM  default 60
#   V1_GLOBAL_RPM                 default 600   the public /api/v1 surface
ALCHEMY_GLOBAL_RPM=
ETHERSCAN_GLOBAL_RPM=
AGGREGATOR_GLOBAL_RPM=
HEAT_GLOBAL_RPM=
RECORD_GLOBAL_RPM=
BIRTHS_GLOBAL_RPM=
LAUNCH_RADAR_GLOBAL_RPM=
LAUNCH_COHORT_GLOBAL_RPM=
LAUNCHER_OUTCOMES_GLOBAL_RPM=
V1_GLOBAL_RPM=
