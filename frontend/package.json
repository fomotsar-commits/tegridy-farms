{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-image-derivatives.mjs && tsc -b tsconfig.app.json tsconfig.node.json && vite build && node scripts/check-dist-graph.mjs && node scripts/render-bungalow-doors.mjs && node scripts/llms-txt.mjs && node scripts/held-through.mjs && node scripts/verify-dist-derivatives.mjs && node scripts/verify-dist-mint.mjs",
    "lint": "eslint .",
    "check:unread": "node scripts/check-unread-signal.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e": "node scripts/run-e2e-with-anvil.mjs",
    "e2e:solana": "playwright test -c playwright.solana.config.ts",
    "precommit": "npm run lint && tsc -b --noEmit",
    "analyze": "ANALYZE=true vite build",
    "verify:env": "node scripts/verify-env.mjs"
  },
