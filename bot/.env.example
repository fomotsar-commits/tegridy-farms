# Tegridy Telegram bot — the complete environment. Copy to .env and fill in.
# Read bot/DEPLOY.md §2 before setting anything; the annotations there explain the
# consequences, this file is the checklist.
#
# THERE IS NO VARIABLE HERE THAT HOLDS, UNLOCKS OR DERIVES A SIGNING KEY, and
# there must never be one. frontend/api/__tests__/bot-noncustodial.test.js fails
# the build over it. If you find yourself wanting to add one, read
# bot/SESSION_KEYS.md first — the non-custodial version of what you want is
# designed there and gated on an audit wave.

# ── Required ────────────────────────────────────────────────────────────────

# From @BotFather. Without it the process refuses to start rather than idling.
TELEGRAM_BOT_TOKEN=

# `openssl rand -hex 32`. MUST be identical to BOT_LINK_SECRET on the Vercel
# deployment: it authenticates the bot to the venue AND derives the chat_ref
# digest that is the only form of a Telegram identity the database ever sees.
#
# Rotating this silently unlinks every user, permanently and unrepairably — the
# Telegram ids that produced the old digests were never stored. See DEPLOY.md §2.
BOT_LINK_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Where /api/aggregator lives. Default https://memetic.fun
VENUE_ORIGIN=

# What the bot puts in the links it hands back. Default https://memetic.fun
APP_ORIGIN=

# The indexer's PUBLIC PROXY ORIGIN, no path — the same value as the frontend's
# VITE_INDEXER_URL. Its absence IS the gate: unset, /history reports that no
# indexer is hosted. It never answers "you have no swaps" instead.
INDEXER_URL=

# Telegram long-poll seconds. Default 30.
TELEGRAM_POLL_TIMEOUT_SEC=
